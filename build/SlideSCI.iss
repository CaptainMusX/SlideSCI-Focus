#ifndef AppVersion
#define AppVersion "1.9.2.0"
#endif

#ifndef SourceRoot
#define SourceRoot "..\artifacts\inno-source-1.9.2.0"
#endif

; Generated by Build-InnoInstaller.ps1 from the signed application manifest.
#include "..\artifacts\VstoTrust.generated.iss"

#define AppId "{7F8E6E4A-9D8D-4B3B-9E86-6A9D3C5A1F72}"

[Setup]
AppId={{#AppId}
AppName=SlideSCI
AppVersion={#AppVersion}
AppVerName=SlideSCI {#AppVersion}
AppPublisher=CaptainMusX
AppPublisherURL=https://github.com/CaptainMusX/SlideSCI
AppSupportURL=https://github.com/CaptainMusX/SlideSCI/issues
DefaultDirName={localappdata}\Programs\SlideSCI
DefaultGroupName=SlideSCI
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
CloseApplications=no
RestartApplications=no
Uninstallable=yes
UninstallDisplayName=SlideSCI {#AppVersion}
OutputDir=..\artifacts\inno
OutputBaseFilename=SlideSCI-{#AppVersion}-Setup
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
VersionInfoVersion={#AppVersion}
VersionInfoProductName=SlideSCI
VersionInfoDescription=SlideSCI PowerPoint add-in installer
VersionInfoCopyright=CaptainMusX
ArchitecturesAllowed=x86 x64compatible
AllowNoIcons=yes

[Files]
; The original release uses a direct VSTO layout rooted at [APPDIR], not a nested ClickOnce Application Files tree.
Source: "{#SourceRoot}\*"; DestDir: "{app}"; Flags: recursesubdirs createallsubdirs ignoreversion

[Icons]
Name: "{group}\Uninstall SlideSCI"; Filename: "{uninstallexe}"

[Code]
procedure RemoveRegistration(RootKey: Integer; KeyName: String);
begin
  if RegKeyExists(RootKey, KeyName) then
  begin
    if not RegDeleteKeyIncludingSubkeys(RootKey, KeyName) then
      Log(Format('无法删除 SlideSCI 注册项: %s', [KeyName]));
  end;
end;

function IsSlideSCIValue(Value: String): Boolean;
begin
  Result := Pos('slidesci', Lowercase(Value)) > 0;
end;

function IsSlideSCIMetadata(RootKey: Integer; KeyName: String): Boolean;
var
  Value: String;
begin
  Result := False;
  if RegQueryStringValue(RootKey, KeyName, 'addInName', Value) and (Lowercase(Value) = 'slidesci') then
    Result := True
  else if RegQueryStringValue(RootKey, KeyName, 'friendlyName', Value) and (Lowercase(Value) = 'slidesci') then
    Result := True
  else if RegQueryStringValue(RootKey, KeyName, 'description', Value) and (Lowercase(Value) = 'slidesci') then
    Result := True;
end;

procedure RemoveVstoSlideSCIMetadata;
var
  Names: TArrayOfString;
  ValueNames: TArrayOfString;
  I: Integer;
  KeyName: String;
  Value: String;
begin
  if RegGetValueNames(HKEY_CURRENT_USER, 'Software\Microsoft\VSTO\SolutionMetadata', ValueNames) then
    for I := GetArrayLength(ValueNames) - 1 downto 0 do
      if IsSlideSCIValue(ValueNames[I]) then
        RegDeleteValue(HKEY_CURRENT_USER, 'Software\Microsoft\VSTO\SolutionMetadata', ValueNames[I]);

  if RegGetSubkeyNames(HKEY_CURRENT_USER, 'Software\Microsoft\VSTO\Security\Inclusion', Names) then
    for I := GetArrayLength(Names) - 1 downto 0 do
    begin
      KeyName := 'Software\Microsoft\VSTO\Security\Inclusion\' + Names[I];
      Value := '';
      if RegQueryStringValue(HKEY_CURRENT_USER, KeyName, 'Url', Value) and IsSlideSCIValue(Value) then
        RemoveRegistration(HKEY_CURRENT_USER, KeyName);
    end;

  if RegGetSubkeyNames(HKEY_CURRENT_USER, 'Software\Microsoft\VSTO\SolutionMetadata', Names) then
    for I := GetArrayLength(Names) - 1 downto 0 do
    begin
      KeyName := 'Software\Microsoft\VSTO\SolutionMetadata\' + Names[I];
      if IsSlideSCIMetadata(HKEY_CURRENT_USER, KeyName) then
        RemoveRegistration(HKEY_CURRENT_USER, KeyName);
    end;
end;

function CurrentManifestBaseUrl: String;
var
  AppPath: String;
begin
  AppPath := ExpandConstant('{app}');
  StringChangeEx(AppPath, '\', '/', True);
  Result := 'file:///' + AppPath + '/CaptainMusX.SlideSCI.vsto';
end;

function CurrentManifestUrl: String;
begin
  Result := CurrentManifestBaseUrl + '|vstolocal';
end;

procedure RegisterVstoInclusion;
var
  InclusionKey: String;
begin
  // Grant full trust only to this exact local manifest URL and signing key.
  InclusionKey := 'Software\Microsoft\VSTO\Security\Inclusion\d0e7a1d9-6cbf-45a9-bd6d-14f42abed932';
  RegWriteStringValue(HKEY_CURRENT_USER, InclusionKey, 'Url', CurrentManifestBaseUrl);
  RegWriteStringValue(HKEY_CURRENT_USER, InclusionKey, 'PublicKey', '{#VstoPublicKey}');
end;

procedure RegisterDirectOfficeAddin;
var
  AddinKey: String;
  AddinManifest: String;
begin
  // The fork uses a unique manifest key so Office cannot reuse the upstream
  // SlideSCI ID's stale ClickOnce deployment URL.
  AddinKey := 'Software\Microsoft\Office\PowerPoint\Addins\CaptainMusX.SlideSCI';
  AddinManifest := CurrentManifestUrl;

  // Remove both identities before writing the manifest-declared key as the only canonical entry.
  RemoveRegistration(HKEY_CURRENT_USER, 'Software\Microsoft\Office\PowerPoint\Addins\Achuan-2.SlideSCI');
  RemoveRegistration(HKEY_CURRENT_USER, 'Software\Microsoft\Office\PowerPoint\Addins\SlideSCI');
  RemoveRegistration(HKEY_CURRENT_USER, 'Software\Microsoft\Office\PowerPoint\Addins\CaptainMusX.SlideSCI');
  RemoveRegistration(HKEY_LOCAL_MACHINE, 'Software\Microsoft\Office\PowerPoint\Addins\Achuan-2.SlideSCI');
  RemoveRegistration(HKEY_LOCAL_MACHINE, 'Software\Microsoft\Office\PowerPoint\Addins\SlideSCI');
  RemoveRegistration(HKEY_LOCAL_MACHINE, 'Software\Microsoft\Office\PowerPoint\Addins\CaptainMusX.SlideSCI');

  RegWriteStringValue(HKEY_CURRENT_USER, AddinKey, 'Manifest', AddinManifest);
  RegWriteDWordValue(HKEY_CURRENT_USER, AddinKey, 'LoadBehavior', 3);
  RegWriteStringValue(HKEY_CURRENT_USER, AddinKey, 'FriendlyName', 'SlideSCI');
  RegWriteStringValue(HKEY_CURRENT_USER, AddinKey, 'Description', 'SlideSCI');
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssPostInstall then
  begin
    RemoveVstoSlideSCIMetadata;
    RegisterDirectOfficeAddin;
    RegisterVstoInclusion;
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usUninstall then
  begin
    RemoveRegistration(HKEY_CURRENT_USER, 'Software\Microsoft\Office\PowerPoint\Addins\Achuan-2.SlideSCI');
    RemoveRegistration(HKEY_CURRENT_USER, 'Software\Microsoft\Office\PowerPoint\Addins\SlideSCI');
    RemoveRegistration(HKEY_CURRENT_USER, 'Software\Microsoft\Office\PowerPoint\Addins\CaptainMusX.SlideSCI');
    RemoveVstoSlideSCIMetadata;
  end;
end;
