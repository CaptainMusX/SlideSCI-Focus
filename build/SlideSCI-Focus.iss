#ifndef AppVersion
#define AppVersion "2.0.7.0"
#endif

#ifndef SourceRoot
#define SourceRoot "..\artifacts\inno-source-2.0.7.0"
#endif

; Generated by Build-InnoInstaller.ps1 from the signed application manifest.
#include "..\artifacts\VstoTrust.generated.iss"

#define AppId "{CB06D2CA-AC8A-4812-A445-106898909DEC}"

[Setup]
AppId={{#AppId}
AppName=SlideSCI Focus
AppVersion={#AppVersion}
AppVerName=SlideSCI Focus {#AppVersion}
AppPublisher=CaptainMusX
AppPublisherURL=https://github.com/CaptainMusX/SlideSCI-Focus
AppSupportURL=https://github.com/CaptainMusX/SlideSCI-Focus/issues
DefaultDirName={localappdata}\Programs\SlideSCI Focus
DefaultGroupName=SlideSCI Focus
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
CloseApplications=no
RestartApplications=no
Uninstallable=yes
UninstallDisplayName=SlideSCI Focus {#AppVersion}
OutputDir=..\artifacts\inno
OutputBaseFilename=SlideSCI-Focus-{#AppVersion}-Setup
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
VersionInfoVersion={#AppVersion}
VersionInfoProductName=SlideSCI Focus
VersionInfoDescription=SlideSCI Focus PowerPoint add-in installer
VersionInfoCopyright=CaptainMusX
ArchitecturesAllowed=x86 x64compatible
AllowNoIcons=yes

[Files]
; The original release uses a direct VSTO layout rooted at [APPDIR], not a nested ClickOnce Application Files tree.
Source: "{#SourceRoot}\*"; DestDir: "{app}"; Flags: recursesubdirs createallsubdirs ignoreversion

[Icons]
Name: "{group}\Uninstall SlideSCI Focus"; Filename: "{uninstallexe}"

[Code]
procedure RemoveRegistration(RootKey: Integer; KeyName: String);
begin
  if RegKeyExists(RootKey, KeyName) then
  begin
    if not RegDeleteKeyIncludingSubkeys(RootKey, KeyName) then
      Log(Format('无法删除 SlideSCI Focus 注册项: %s', [KeyName]));
  end;
end;

function IsSlideSCIFocusValue(Value: String): Boolean;
begin
  Result := (Pos('captainmusx.slidesci', Lowercase(Value)) > 0) or
    (Pos('slidesci.focus', Lowercase(Value)) > 0) or
    (Pos('slidesci focus', Lowercase(Value)) > 0);
end;

function IsSlideSCIFocusMetadata(RootKey: Integer; KeyName: String): Boolean;
var
  Value: String;
begin
  Result := False;
  if RegQueryStringValue(RootKey, KeyName, 'addInName', Value) and IsSlideSCIFocusValue(Value) then
    Result := True
  else if RegQueryStringValue(RootKey, KeyName, 'friendlyName', Value) and IsSlideSCIFocusValue(Value) then
    Result := True
  else if RegQueryStringValue(RootKey, KeyName, 'description', Value) and IsSlideSCIFocusValue(Value) then
    Result := True;
end;

procedure RemoveVstoSlideSCIFocusMetadata;
var
  Names: TArrayOfString;
  ValueNames: TArrayOfString;
  I: Integer;
  KeyName: String;
  Value: String;
begin
  if RegGetValueNames(HKEY_CURRENT_USER, 'Software\Microsoft\VSTO\SolutionMetadata', ValueNames) then
    for I := GetArrayLength(ValueNames) - 1 downto 0 do
      if IsSlideSCIFocusValue(ValueNames[I]) then
        RegDeleteValue(HKEY_CURRENT_USER, 'Software\Microsoft\VSTO\SolutionMetadata', ValueNames[I]);

  if RegGetSubkeyNames(HKEY_CURRENT_USER, 'Software\Microsoft\VSTO\Security\Inclusion', Names) then
    for I := GetArrayLength(Names) - 1 downto 0 do
    begin
      KeyName := 'Software\Microsoft\VSTO\Security\Inclusion\' + Names[I];
      Value := '';
      if RegQueryStringValue(HKEY_CURRENT_USER, KeyName, 'Url', Value) and IsSlideSCIFocusValue(Value) then
        RemoveRegistration(HKEY_CURRENT_USER, KeyName);
    end;

  if RegGetSubkeyNames(HKEY_CURRENT_USER, 'Software\Microsoft\VSTO\SolutionMetadata', Names) then
    for I := GetArrayLength(Names) - 1 downto 0 do
    begin
      KeyName := 'Software\Microsoft\VSTO\SolutionMetadata\' + Names[I];
      if IsSlideSCIFocusMetadata(HKEY_CURRENT_USER, KeyName) then
        RemoveRegistration(HKEY_CURRENT_USER, KeyName);
    end;
end;

function CurrentManifestBaseUrl: String;
var
  AppPath: String;
begin
  AppPath := ExpandConstant('{app}');
  StringChangeEx(AppPath, '\', '/', True);
  Result := 'file:///' + AppPath + '/CaptainMusX.SlideSCI.Focus.vsto';
end;

function CurrentManifestUrl: String;
begin
  Result := CurrentManifestBaseUrl + '|vstolocal';
end;

procedure RegisterVstoInclusion;
var
  InclusionKey: String;
begin
  // Grant full trust only to this exact local manifest URL and signing key.
  InclusionKey := 'Software\Microsoft\VSTO\Security\Inclusion\48652793-e6d0-4fa2-bce9-cfd345b8ffec';
  RegWriteStringValue(HKEY_CURRENT_USER, InclusionKey, 'Url', CurrentManifestBaseUrl);
  RegWriteStringValue(HKEY_CURRENT_USER, InclusionKey, 'PublicKey', '{#VstoPublicKey}');
end;

procedure RegisterDirectOfficeAddin;
var
  AddinKey: String;
  AddinManifest: String;
begin
  // SlideSCI Focus uses a unique manifest key so Office can distinguish it
  // from both the upstream add-in and the earlier local fork identity.
  AddinKey := 'Software\Microsoft\Office\PowerPoint\Addins\CaptainMusX.SlideSCI.Focus';
  AddinManifest := CurrentManifestUrl;

  // Remove only this fork's earlier identity. Leave the upstream add-in alone
  // so users may keep both products installed.
  RemoveRegistration(HKEY_CURRENT_USER, 'Software\Microsoft\Office\PowerPoint\Addins\CaptainMusX.SlideSCI');
  RemoveRegistration(HKEY_CURRENT_USER, 'Software\Microsoft\Office\PowerPoint\Addins\CaptainMusX.SlideSCI.Focus');
  RemoveRegistration(HKEY_LOCAL_MACHINE, 'Software\Microsoft\Office\PowerPoint\Addins\CaptainMusX.SlideSCI');
  RemoveRegistration(HKEY_LOCAL_MACHINE, 'Software\Microsoft\Office\PowerPoint\Addins\CaptainMusX.SlideSCI.Focus');

  RegWriteStringValue(HKEY_CURRENT_USER, AddinKey, 'Manifest', AddinManifest);
  RegWriteDWordValue(HKEY_CURRENT_USER, AddinKey, 'LoadBehavior', 3);
  RegWriteStringValue(HKEY_CURRENT_USER, AddinKey, 'FriendlyName', 'SlideSCI Focus');
  RegWriteStringValue(HKEY_CURRENT_USER, AddinKey, 'Description', 'SlideSCI Focus');
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssPostInstall then
  begin
    RemoveVstoSlideSCIFocusMetadata;
    RegisterDirectOfficeAddin;
    RegisterVstoInclusion;
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usUninstall then
  begin
    RemoveRegistration(HKEY_CURRENT_USER, 'Software\Microsoft\Office\PowerPoint\Addins\CaptainMusX.SlideSCI');
    RemoveRegistration(HKEY_CURRENT_USER, 'Software\Microsoft\Office\PowerPoint\Addins\CaptainMusX.SlideSCI.Focus');
    RemoveRegistration(HKEY_LOCAL_MACHINE, 'Software\Microsoft\Office\PowerPoint\Addins\CaptainMusX.SlideSCI');
    RemoveRegistration(HKEY_LOCAL_MACHINE, 'Software\Microsoft\Office\PowerPoint\Addins\CaptainMusX.SlideSCI.Focus');
    RemoveVstoSlideSCIFocusMetadata;
  end;
end;
